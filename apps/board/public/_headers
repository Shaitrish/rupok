# Cloudflare static-asset headers.
# Hashed build assets never change: cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Offline libraries for Smart Objects. Objects run in sandboxed (opaque-origin)
# frames, so module scripts and fonts need CORS.
/rupoklib/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

# Markdown twins of the pages, for AI agents (linked from /llms.txt). The HTML
# page is the canonical one for search engines.
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: SAMEORIGIN
