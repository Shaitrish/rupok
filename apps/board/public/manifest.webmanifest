{
  "name": "Rupok — Mind Over Matter",
  "short_name": "Rupok",
  "description": "The open-source smart whiteboard for teachers: live AI content, pen on top, every class replayable.",
  "start_url": "/board/",
  "scope": "/board/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#eceef2",
  "theme_color": "#111418",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/board/",
      "accept": {
        "application/vnd.rupok.lesson+zip": [
          ".rpk"
        ]
      }
    }
  ],
  "id": "/board/"
}
