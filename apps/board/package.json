  "scripts": {
    "wasm": "cd ../.. && cargo build -p rupok-wasm --target wasm32-unknown-unknown --profile release-wasm && wasm-bindgen --target web --out-dir apps/board/src/wasm --out-name rupok target/wasm32-unknown-unknown/release-wasm/rupok_wasm.wasm",
