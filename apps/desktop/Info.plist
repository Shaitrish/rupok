<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the macOS app bundle's Info.plist. Voice input
     (speech-to-text) asks for the microphone, and for Apple's speech
     recognition when Web Speech runs in WKWebView. Audio is never recorded. -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Rupok uses the microphone only while you dictate text (voice input). Audio is never recorded or stored.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Rupok turns your speech into text while you dictate. On recent macOS this happens on your Mac.</string>
</dict>
</plist>
